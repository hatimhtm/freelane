<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle in-app updates. The rest of Info.plist is generated by Xcode
	     (GENERATE_INFOPLIST_FILE = YES) and merged on top of these keys. -->
	<key>SUFeedURL</key>
	<string>https://github.com/hatimhtm/freelane/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>WC5lwvOF89DNNoaqkTAcEXpmVGgOsjNATYKj17s90aY=</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>

	<!-- The app icon, shipped as a real .icns alongside the asset catalog.
	     The catalog's generated AppIconV2.icns carried only four representations, topping out
	     at 256px (66 KB) — so on a Retina Dock, which asks for 512 and 1024, macOS had nothing
	     to draw and fell back to whatever it had cached from an older build. That's why the Dock
	     kept showing the previous icon after the new one shipped. This file carries all ten
	     representations (1.15 MB) and CFBundleIconFile makes macOS prefer it. -->
	<key>CFBundleIconFile</key>
	<string>Freelane</string>
</dict>
</plist>
